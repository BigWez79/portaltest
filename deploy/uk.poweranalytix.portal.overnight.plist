<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>uk.poweranalytix.portal.overnight</string>

    <!-- ================================================================= --
         NO SUPABASE VARIABLES ARE PASSED. That is the point of this file.

         The suite does not need them. playwright.config.ts sets STAFF_SOURCE=
         fixture and supplies its own throwaway SUPABASE_URL / ANON_KEY /
         SERVICE_ROLE_KEY so the app can construct its clients, and staff rows
         are read from tests/fixtures/staff.json. Nothing in `npm run verify`
         reaches a real project. So the guarantee here is absence, not a flag:
         there is no variable to set wrongly, no default to fall through to,
         and no line anyone can add later that quietly re-enables it. A flag
         can be flipped by a task editing this file; a variable that was never
         passed cannot be.

         Two things absence does NOT cover, so they are handled explicitly
         below rather than assumed:

           1. `supabase db push` authenticates with the CLI's own access token
              in ~/.supabase, not with any environment variable. Withholding
              SUPABASE_* does nothing to stop it. Hence
              OVERNIGHT_APPLY_MIGRATIONS=0, which is a flag, and is weaker for
              exactly the reason above — it is prose the runner has to honour.
              BLOCKED.md is the real rule: a person types `! supabase db push`,
              and an instruction in chat does not stand in for that.

           2. `.env.local` is loaded by `next build` all on its own. It holds
              live portal-staging keys. The plist cannot unset a file, so the
              honest position is that absence covers what this file controls
              and .env.local is the remaining route in. It is 0600, gitignored,
              and the build only compiles — but do not read this comment as a
              claim that the nightly run cannot see staging credentials.

         RESEND_API_KEY is withheld on the same principle. src/lib/notify.ts is
         a no-op without it, so an unattended run cannot send anyone email.

         E2E_TEST_MODE is absent deliberately and must stay absent.
         playwright.config.ts sets it for the suite and nothing else may — it
         turns on a route that will sign in as anybody (CLAUDE.md, rule 7).
         -- ================================================================= -->

    <!-- PATH is set EXPLICITLY rather than trusted, which is I Love Wight's
         lesson and not worth relearning: its 02:00 run on 2026-08-25 died
         instantly with "claude CLI not on PATH". launchd starts from a
         near-empty environment, and ~/.local/bin — where claude lives — is not
         added by any login file. node, npm, supabase and git all survive a
         login shell; claude alone did not.

         zsh -lc so the job still gets a login shell, since overnight.sh needs
         node, npm and git on PATH and a bare launchd environment has none of
         them.

         The runner is the INSTALLED copy, for the same reason as the
         keep-alive: a job that reads its own script out of a git checkout stops
         working the moment a branch without it is left checked out. The working
         directory is still the repo, because the runner operates on the repo —
         it just does not live there any more. deploy/install.sh copies it, and
         must be re-run after editing, or the scheduled run uses a stale one.

         The guard is there because THE PORTAL HAS NO ./overnight.sh YET, so
         install.sh has nothing to copy and this job is inert. It fails loudly
         into the log rather than silently doing nothing, which is the failure
         mode that wasted a night on the other repo. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>-lc</string>
        <string>export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"; cd /Users/wesleyhughes/portal || exit 1; RUNNER="$HOME/.local/libexec/poweranalytix/overnight.sh"; [ -x "$RUNNER" ] || { printf '[%s] FATAL: %s is not installed — the portal has no runner yet. Write ./overnight.sh, then run deploy/install.sh.\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$RUNNER"; exit 78; }; OVERNIGHT_APPLY_MIGRATIONS=0 exec "$RUNNER"</string>
    </array>

    <!-- 03:00, not 02:00. I Love Wight has 02:00 and this is the same Mac:
         two headless Claude runs and two Playwright suites at once would
         contend for CPU and make both nights slower and less predictable.
         TASKS.md already measures its own tasks against "something working
         alone at 3am", so this is the hour the queue was written for. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key><integer>3</integer>
        <key>Minute</key><integer>0</integer>
    </dict>

    <key>WorkingDirectory</key>
    <string>/Users/wesleyhughes/portal</string>

    <!-- launchd's own view of the run, outside the repo: a log written into
         the working tree leaves an untracked file on any branch whose
         .gitignore does not cover it, and an untracked file aborts the next
         night. The runner's own detailed transcripts still go under
         agent_logs/, which .gitignore does cover. launchd does not expand
         variables in these, so they are literal. -->
    <key>StandardOutPath</key>
    <string>/Users/wesleyhughes/Library/Logs/PowerAnalytix/overnight.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/wesleyhughes/Library/Logs/PowerAnalytix/overnight.err.log</string>

    <!-- Never at load: bootstrapping this job should not kick off a run that
         commits code. If the Mac is asleep at 03:00, launchd runs it on wake
         rather than skipping the night. -->
    <key>RunAtLoad</key>
    <false/>
    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
