# Copy to .env.local. Never commit a filled-in copy — .gitignore covers .env,
# .env.* and .env.txt, and the safest habit is not to create one anywhere else.
#
# Nothing here is prefixed NEXT_PUBLIC_, and nothing needs to be: the portal
# talks to Supabase only from the server. `npm run check:secrets` reads the built
# output and fails if a key ever reaches a browser.

# ---- Supabase ---------------------------------------------------------------
# The same project for all four suite apps — that is what makes one sign-in
# cover the whole suite. See docs/SUITE-IDENTITY.md.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Used for exactly two things: inviting a person, and the one-off CSV import.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Session ----------------------------------------------------------------
# Set in every deployed environment so invoices/timesheet/expenses read the same
# session. Leave unset locally, where the cookie should stay host-only.
# SESSION_COOKIE_DOMAIN=.poweranalytix.co.uk

# Absolute origin, used to build magic-link callback URLs. On Vercel this falls
# back to VERCEL_URL, which is correct for previews.
SITE_URL=http://localhost:3000

# ---- Email ------------------------------------------------------------------
# Sign-in and invitation emails go out through Supabase Auth's SMTP settings —
# point those at Resend in the Supabase dashboard (a person does this once).
#
# This key is only for the courtesy note when somebody's access changes. Leave it
# unset and that email is silently skipped; nothing else breaks.
RESEND_API_KEY=
RESEND_FROM=Power Analytix <no-reply@poweranalytix.co.uk>

# ---- Fallback admins --------------------------------------------------------
# Comma separated. A bootstrap admin sees every tile and can reach the admin
# screen even with no staff row, so the portal cannot lock its own administrator
# out — during the import, or after a bad flag edit. This is the way back in.
BOOTSTRAP_ADMINS=wesley.hughes@utilitiesms.co.uk

# ---- Test harness -----------------------------------------------------------
# Set by playwright.config.ts only. Never set these in a deployed environment:
# E2E_TEST_MODE=1 turns on a route that will sign in as anybody.
# E2E_TEST_MODE=1
# STAFF_SOURCE=fixture
