# Copy to .env.local. Never commit a filled-in copy — .gitignore covers
# .env, .env.* and .env.txt, but the safest habit is not to create one outside
# this directory in the first place.

# ---- Auth.js ----------------------------------------------------------------
# openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# ---- Entra ID (portal sign-in) ---------------------------------------------
# A NEW registration, separate from the SPA registration the Timesheet and
# Expenses apps share. This one is a confidential client with a Web redirect URI
# and a secret; the SPA registration must not be given one.
#
#   Redirect URI: https://portal.poweranalytix.co.uk/api/auth/callback/microsoft-entra-id
#   API permissions: openid, profile, email. No Graph scopes at all.
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
ENTRA_TENANT_ID=be344548-8db6-49d6-8155-1f85b6ae1dad

# ---- Supabase (server-side only) -------------------------------------------
# Note the absence of NEXT_PUBLIC_. Next.js inlines any NEXT_PUBLIC_* variable
# into the client bundle and `npm run check:secrets` fails the build if one of
# these ever gains that prefix.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Fallback admins --------------------------------------------------------
# Carried over from portal v2.0. Comma separated. A bootstrap admin sees every
# tile even with no staff row, so the portal cannot lock out its administrator
# while the staff table is empty or mid-sync.
BOOTSTRAP_ADMINS=wesley.hughes@utilitiesms.co.uk

# ---- Staff sync (scripts/sync-staff.ts, not the web app) --------------------
# A second, app-only registration with Sites.Selected granted on the
# PowerAnalytix site alone. This is the only Graph permission in the project.
SYNC_CLIENT_ID=
SYNC_CLIENT_SECRET=
STAFF_SITE_ID=netorgft7286889.sharepoint.com,7dbdec72-9051-417c-aa77-60ddcb37ce04,05fda148-0a25-40ac-b274-a47edcacdfbb
STAFF_LIST_ID=90c04da4-7c45-480a-982b-64b6de6cb357

# ---- Test harness -----------------------------------------------------------
# Set by playwright.config.ts only. Never set these in a deployed environment:
# E2E_TEST_MODE=1 turns on a route that will sign in as anybody.
# E2E_TEST_MODE=1
# STAFF_SOURCE=fixture
