{
  "name": "poweranalytix-portal",
  "version": "3.0.0",
  "private": true,
  "description": "Power Analytix Suite Portal \u2014 one sign-in for the whole suite.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "check:secrets": "node scripts/check-bundle-secrets.mjs",
    "verify": "npm run typecheck && npm run build && npm run check:secrets && npm run test:e2e",
    "import:staff": "tsx scripts/import-staff.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.58.0",
    "next": "^16.3.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "resend": "^6.22.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.13.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
